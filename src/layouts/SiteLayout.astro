---
import type { PageMetadata } from "../lib/metadata";

import SiteHead from "../components/SiteHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SkipLink from "../components/SkipLink.astro";

import "../styles/global.css";
import "../styles.css";

type Props = PageMetadata;
---

<!doctype html>
<html lang="en" dir="ltr">
	<head>
		<SiteHead page={Astro.props} />
	</head>
	<body>
		<SkipLink />
		<Header writingSection={Astro.props.type === "BlogPosting"} />
		<main id="content" tabindex="-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<script>
	const turnProperty = "--focus-turn";

	document.addEventListener("transitionend", ({ propertyName, pseudoElement, target }) => {
		if (
			propertyName !== "--focus-angle" ||
			pseudoElement !== "::before" ||
			!(target instanceof HTMLElement) ||
			!target.matches(":focus-visible")
		) {
			return;
		}

		const turn = Number(target.style.getPropertyValue(turnProperty) || 1);
		target.style.setProperty(turnProperty, String(turn + 1));
	});

	document.addEventListener("focusout", ({ target }) => {
		if (target instanceof HTMLElement) target.style.removeProperty(turnProperty);
	});
</script>
