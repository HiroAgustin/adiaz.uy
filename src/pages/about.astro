---
import Portrait from "../components/Portrait.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import styles from "./About.module.css";
import content from "../styles/Content.module.css";
import linkStyles from "../styles/LinkUnderline.module.css";
---

<SiteLayout
	title="About"
	description="About Agustín Díaz, a design engineer working across design and frontend engineering, and the author of adiaz.uy."
	type="AboutPage"
>
	<article class:list={[content.page, "mx-auto"]}>
		<header class:list={[content.heading, styles.heading]}>
			<div class={content.prose}>
				<h1>
					Hi, I’m{" "}
					<span class="heading-outline" data-transition="first-name">
						Agustín
					</span>
				</h1>
				<p class={content.intro}>
					I’ve been building for the web since 2009 and I’m currently a design engineer at{" "}
					<strong>GitHub</strong>.
				</p>
				<p>
					The browser is where I do my best design work. I like getting an interaction right there,
					then giving it a home in the design system so the next person doesn’t have to start over.
				</p>
			</div>
			<Portrait
				class={styles.portrait}
				size={224}
				height={280}
				alt="Agustín Díaz"
				fetchpriority="high"
			/>
		</header>
		<div class={content.prose}>
			<p>
				I’ve worked at both startups (<strong>Personio</strong>, <strong>Frameable</strong>, and{" "}
				<strong>Plectica</strong>) and large companies (<strong>Stripe</strong>,{" "}
				<strong>New Relic</strong>, and <strong>NetSuite</strong>). What I care about is the same
				either way: shipping interfaces that feel good to use, down to the little details.
			</p>
			<p>
				Attending the{" "}
				<a class={linkStyles.underline} href="https://www.recurse.com/">
					Recurse Center
				</a>{" "}
				made me a better programmer. It’s also where I met some of the kindest people I know.
			</p>
			<h2>Outside work</h2>
			<p>
				My kid keeps me busy. When I get some time to myself, I like to read or play video and board
				games. The Hiro in <em>HiroAgustin</em> is my gaming moniker, borrowed from{" "}
				<a class={linkStyles.underline} href="https://en.wikipedia.org/wiki/Hiro_Nakamura">
					Hiro Nakamura
				</a>
				, the space-time bending programmer samurai.
			</p>
		</div>
	</article>
</SiteLayout>
