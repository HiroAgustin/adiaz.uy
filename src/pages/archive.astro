---
import SiteLayout from "../layouts/SiteLayout.astro";
import { formatDate, getPosts } from "../lib/posts";

const posts = await getPosts();
---

<SiteLayout
	type="CollectionPage"
	title="Archive"
	description="Browse all articles by Agustín Díaz on web development, frontend engineering, CSS, JavaScript, and design."
	items={posts.map((post) => ({ name: post.data.title, url: `/${post.id}/` }))}
>
	<article>
		<h1>Archive</h1>
		<ul role="list">
			{posts.map((post) => (
				<li>
					<a href={`/${post.id}/`}>{post.data.title}</a>{" "}
					<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
				</li>
			))}
		</ul>
	</article>
</SiteLayout>
