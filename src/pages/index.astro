---
import SiteLayout from "../layouts/SiteLayout.astro";
import Portrait from "../components/Portrait.astro";
import PostList from "../components/PostList.astro";
import { featuredPosts, getPosts } from "../lib/posts";
import styles from "./Home.module.css";

const postsById = new Map((await getPosts()).map((post) => [post.id, post]));
const posts = Array.from(featuredPosts.keys(), (id) => {
	const post = postsById.get(id);
	if (!post) throw new Error(`Missing featured post: ${id}`);
	return post;
});
---

<SiteLayout type="WebSite" title="Agustín Díaz — Design Engineer">
	<div class:list={[styles.page, "mx-auto"]}>
		<section class:list={[styles.intro, "grid gap-4"]} aria-labelledby="intro-title">
			<div class={styles.byline}>
				<div class="min-inline-0">
					<h1 id="intro-title">
						<span class="heading-outline" data-transition="first-name">
							Agustín
						</span>{" "}
						Díaz
					</h1>
					<p class={styles.location}>
						<span class={styles.role}>Design Engineer</span>
					</p>
				</div>
				<Portrait
					class={styles.avatar}
					size={160}
					height={128}
					alt=""
					responsive={{
						widths: [120, 160, 240, 320, 480],
						sizes: "(max-width: 24rem) 34vw, (max-width: 29rem) 38vw, 10rem",
					}}
				/>
			</div>
			<p>
				I like building design systems and accessible interfaces for complex products. I still enjoy
				seeing what the browser can do on its own.
			</p>
			<p>
				I’ve worked on the web for over 17 years, including more than five with React and
				TypeScript. At GitHub, I build interfaces for security products and recently migrated the
				Dependabot alert list from Rails to React, including filters, sorting, pagination, and bulk
				actions.
			</p>
		</section>

		<section
			class:list={[styles.writings, "grid gap-3"]}
			aria-labelledby="writing-title"
			data-transition="writings-panel"
		>
			<h2 id="writing-title" data-transition="writing-title">
				Selected writings
			</h2>
			<PostList posts={posts} variant="plain" showSummaries />
		</section>
	</div>
</SiteLayout>
