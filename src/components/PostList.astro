---
import type { CollectionEntry } from "astro:content";
import { featuredPosts, formatDate, postTransitionName } from "../lib/posts";
import styles from "./PostList.module.css";
import linkStyles from "../styles/LinkUnderline.module.css";
import metadata from "../styles/Metadata.module.css";

interface Props {
	posts: CollectionEntry<"blog">[];
	variant?: "plain" | "ruled";
	showSummaries?: boolean;
}

const { posts, variant = "ruled", showSummaries = false } = Astro.props;
---

<ul class:list={[styles.list, variant === "plain" && styles.plain]} role="list">
	{posts.map((post, index) => (
		<li
			style={{
				"--post-index": index,
				"--post-transition": featuredPosts.has(post.id)
					? postTransitionName(post.id, "row")
					: undefined,
			}}
		>
			<a class:list={[styles.link, "gap-x-4 gap-y-1"]} href={`/${post.id}/`}>
				<span
					class:list={[styles.title, linkStyles.underline]}
					data-transition={featuredPosts.has(post.id) ? "post-title" : undefined}
					style={{
						"--post-title-transition": featuredPosts.has(post.id)
							? postTransitionName(post.id, "title")
							: undefined,
					}}
				>
					{post.data.title}
				</span>
				<time class:list={[metadata.label, styles.date]} datetime={post.data.pubDate.toISOString()}>
					{formatDate(post.data.pubDate)}
				</time>
				{showSummaries && <span class={styles.summary}>{featuredPosts.get(post.id)}</span>}
			</a>
		</li>
	))}
</ul>
