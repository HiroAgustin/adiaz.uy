---
import styles from "./Role.module.css";

const roles = ["Design", "Frontend", "Product", "Full-Stack"];
---

<p class={styles.Role}>
	<span class="sr-only">Design Engineer</span>
	<span class={styles.label} aria-hidden="true">
		<span class={styles.reel}>
			{roles.map((role) => (
				<span>{role}</span>
			))}
		</span>
		Engineer
	</span>
</p>
