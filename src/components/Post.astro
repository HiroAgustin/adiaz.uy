---
import type { CollectionEntry } from "astro:content";
import { featuredPosts, formatDate, postTransitionName } from "../lib/Articles";
import styles from "./Post.module.css";

interface Props {
	post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const featured = featuredPosts.has(post.id);
---

<article class:list={["contentPage", "mx-auto"]}>
	<header class={"contentHeading"}>
		<time
			class:list={["metadataLabel", "metadataEyebrow"]}
			datetime={post.data.pubDate.toISOString()}
		>
			{formatDate(post.data.pubDate)}
		</time>
		<h1
			data-transition={featured ? "post-title" : undefined}
			style={{
				"--post-title-transition": featured ? postTransitionName(post.id, "title") : undefined,
			}}
		>
			{post.data.title}
		</h1>
	</header>

	<div class:list={["contentProse", styles.Post]}>
		<slot />
	</div>
</article>
