---
import { siteMetadata } from "../lib/Identity";
import Nav from "./Nav.astro";
import styles from "./Header.module.css";

interface Props {
	writingSection: boolean;
}

const writingSection = Astro.props.writingSection;
---

<header
	class:list={[
		styles.Header,
		"relative flex flex-wrap items-center justify-between gap-x-4 gap-y-2",
	]}
>
	<a
		class:list={[styles.wordmark, "inline-flex items-center font-bold no-underline"]}
		href="/"
		aria-label={`${siteMetadata.title} home`}
	>
		<span aria-hidden="true">⊹</span> {siteMetadata.title}
	</a>
	<Nav writingSection={writingSection} />
</header>
