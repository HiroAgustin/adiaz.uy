---
import { siteMetadata } from "../lib/site";
import styles from "./Footer.module.css";
import linkStyles from "../styles/LinkUnderline.module.css";
import metadata from "../styles/Metadata.module.css";

const drawDuration = "0.45s";
const drawSpline = "0.22 1 0.36 1";

const links = [
	{
		label: "GitHub",
		href: "https://github.com/HiroAgustin/",
		color: "url(#footergithubgradient)",
		drawOffset: -100,
		paths: [
			"M9 19c-5 1.5-5-2.5-7-3",
			"M16 22v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22",
		],
	},
	{
		label: "LinkedIn",
		href: "https://linkedin.com/in/HiroAgustin/en/",
		color: "#0077B5",
		drawOffsets: [-100, -100, -100],
		drawStages: [1, 0, 0],
		paths: [
			"M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z",
			"M2 9h4v12H2z",
			"M4 2a2 2 0 1 1 0 4 2 2 0 1 1 0-4",
		],
	},
	{
		label: "Bluesky",
		href: "https://bsky.app/profile/adiaz.uy/",
		color: "#1185FE",
		drawOffset: -100,
		paths: [
			"M12 11.358c1.087-2.247 4.046-6.436 6.798-8.501C20.783 1.366 24 .213 24 3.883c0 .732-.42 6.156-.667 7.037-.856 3.061-3.978 3.842-6.755 3.37 4.854.826 6.089 3.562 3.422 6.299-5.065 5.196-7.28-1.304-7.847-2.97-.104-.305-.152-.448-.153-.327 0-.121-.05.022-.153.327-.568 1.666-2.782 8.166-7.847 2.97-2.667-2.737-1.432-5.473 3.422-6.3-2.777.473-5.899-.308-6.755-3.369C.42 10.04 0 4.615 0 3.883c0-3.67 3.217-2.517 5.202-1.026C7.954 4.922 10.913 9.11 12 11.358",
		],
	},
	{
		label: "RSS",
		href: "/rss.xml",
		color: "#ffa500",
		drawOffsets: [100, -100, 100],
		paths: ["M4 4c8.84 0 16 7.16 16 16", "M4 11a9 9 0 0 1 9 9", "M4 18a2 2 0 0 1 2 2"],
	},
];
---

<footer class={styles.footer}>
	<div>
		<p class:list={[metadata.label, metadata.eyebrow]}>Get in touch</p>
		<a class={styles.email} href={`mailto:${siteMetadata.author.email}`}>
			{siteMetadata.author.email}
		</a>
	</div>
	<div class:list={[styles.links, metadata.label, "flex flex-wrap"]}>
		<ul class="flex flex-wrap gap-x-5 gap-y-1" role="list">
			{links.map(({ label, href, color, paths, drawOffset = 100, drawOffsets, drawStages }) => (
				<li>
					<a
						id={`footer${label.toLowerCase()}`}
						class:list={[linkStyles.underline, styles.socialLink, "inline-flex items-center"]}
						href={href}
					>
						<svg
							aria-hidden="true"
							viewBox="-1 -1 26 26"
							width="20"
							height="20"
							stroke-width="1.6"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							{label === "GitHub" && (
								<defs>
									<linearGradient
										id="footergithubgradient"
										gradientUnits="userSpaceOnUse"
										x1="0"
										y1="0"
										x2="24"
										y2="24"
									>
										<stop offset="0%" stop-color="#ff3b30" />
										<stop offset="20%" stop-color="#ff9500" />
										<stop offset="40%" stop-color="#ffcc00" />
										<stop offset="60%" stop-color="#34c759" />
										<stop offset="80%" stop-color="#00aaff" />
										<stop offset="100%" stop-color="#af52de" />
									</linearGradient>
								</defs>
							)}
							<style is:inline>
								@media (prefers-reduced-motion: reduce) {
									.footer-social-outline { stroke-dashoffset: 100 !important; stroke-opacity: 0 !important; }
									a:is(:hover, :focus) .footer-social-outline { stroke-dashoffset: 0 !important; stroke-opacity: 1 !important; }
									.footer-social-base { opacity: 1 !important; }
									a:is(:hover, :focus) .footer-social-base { opacity: 0 !important; }
								}
							</style>
							<g class="footer-social-base">
								<animate
									attributeName="opacity"
									values="1;1;0"
									keyTimes="0;0.7;1"
									dur={drawDuration}
									begin={`footer${label.toLowerCase()}.mouseover`}
									fill="freeze"
								/>
								<set
									attributeName="opacity"
									to="1"
									dur="0.01s"
									begin={`footer${label.toLowerCase()}.mouseout`}
									fill="freeze"
								/>
								<g class="footer-social-base">
									<animate
										attributeName="opacity"
										values="1;1;0"
										keyTimes="0;0.7;1"
										dur={drawDuration}
										begin={`footer${label.toLowerCase()}.focus`}
										fill="freeze"
									/>
									<set
										attributeName="opacity"
										to="1"
										dur="0.01s"
										begin={`footer${label.toLowerCase()}.blur`}
										fill="freeze"
									/>
									{paths.map((path) => (
										<path d={path} fill="none" stroke="var(--text)" />
									))}
								</g>
							</g>
							{["mouse", "focus"].map((interaction) =>
								paths.map((path, index) => {
									const stage = drawStages?.[index] ?? paths.length - index - 1;
									const stageCount = drawStages ? Math.max(...drawStages) + 1 : paths.length;
									return (
										<path
											class="footer-social-outline"
											d={path}
											fill="none"
											stroke={color}
											pathLength="100"
											stroke-dasharray="100"
											stroke-dashoffset={drawOffsets?.[index] ?? drawOffset}
											stroke-opacity="0"
										>
											<animate
												attributeName="stroke-dashoffset"
												to={drawOffsets ? undefined : "0"}
												values={
													drawOffsets
														? Array.from({ length: stageCount + 1 }, (_, step) =>
																step <= stage ? drawOffsets[index] : 0,
															).join(";")
														: undefined
												}
												dur={drawDuration}
												calcMode="spline"
												keyTimes={
													drawOffsets
														? Array.from(
																{ length: stageCount + 1 },
																(_, step) => step / stageCount,
															).join(";")
														: "0;1"
												}
												keySplines={
													drawOffsets ? Array(stageCount).fill(drawSpline).join(";") : drawSpline
												}
												begin={`footer${label.toLowerCase()}.${interaction === "mouse" ? "mouseover" : "focus"}`}
												fill="freeze"
											/>
											<animate
												attributeName="stroke-dashoffset"
												to={drawOffsets?.[index] ?? drawOffset}
												dur="0.2s"
												begin={`footer${label.toLowerCase()}.${interaction === "mouse" ? "mouseout" : "blur"}`}
												fill="freeze"
											/>
											<animate
												attributeName="stroke-opacity"
												to={drawOffsets && stage > 0 ? undefined : "1"}
												values={drawOffsets && stage > 0 ? "0;1;1" : undefined}
												keyTimes={
													drawOffsets && stage > 0 ? `0;${stage / stageCount};1` : undefined
												}
												calcMode={drawOffsets && stage > 0 ? "discrete" : undefined}
												dur={drawOffsets && stage > 0 ? drawDuration : "0.01s"}
												begin={`footer${label.toLowerCase()}.${interaction === "mouse" ? "mouseover" : "focus"}`}
												fill="freeze"
											/>
											<animate
												attributeName="stroke-opacity"
												to={drawOffsets ? "0" : undefined}
												values={drawOffsets ? undefined : "1;1;0"}
												keyTimes={drawOffsets ? undefined : "0;0.95;1"}
												calcMode={drawOffsets ? "discrete" : undefined}
												dur="0.2s"
												begin={`footer${label.toLowerCase()}.${interaction === "mouse" ? "mouseout" : "blur"}`}
												fill="freeze"
											/>
										</path>
									);
								}),
							)}
						</svg>
						{label}
					</a>
				</li>
			))}
		</ul>
	</div>
</footer>
