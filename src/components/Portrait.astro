---
import { Image } from "astro:assets";
import avatar from "../assets/Portrait.jpg";
import styles from "./Portrait.module.css";

interface Props {
	size: number;
	height: number;
	alt: string;
	class: string;
	fetchpriority?: "high" | "low" | "auto";
	responsive: { widths: number[]; sizes: string };
}

const { size, height, alt, class: className, fetchpriority, responsive } = Astro.props;
---

<div class:list={[styles.Portrait, className, "relative flex-none"]}>
	<div class:list={[styles.image, "relative isolate"]}>
		<Image
			src={avatar}
			alt={alt}
			width={size}
			height={height}
			{...responsive}
			format="webp"
			fit="cover"
			loading="eager"
			fetchpriority={fetchpriority}
			class="block"
		/>
	</div>
	<div class={styles.tiltGrid} aria-hidden="true">
		{Array.from({ length: 9 }, () => (
			<span />
		))}
	</div>
</div>
