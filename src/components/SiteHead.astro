---
import { Font } from "astro:assets";
import { getPageMetadata, type PageMetadata } from "../lib/metadata";
import { siteMetadata } from "../lib/site";

interface Props {
	page: PageMetadata;
}

const { title, description, type, publishedAt, modifiedAt, canonical, image, structuredData } =
	getPageMetadata(Astro.props.page, Astro.url, Astro.site);
---

<meta charset="UTF-8" />
<meta name="color-scheme" content="only dark" />
<meta http-equiv="x-ua-compatible" content="ie=edge" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<Font cssVariable="--font-body" preload={[{ weight: 400, style: "normal" }]} />
<Font cssVariable="--font-heading" preload />
<meta name="google-site-verification" content="H3h1-fkuHBo-jtqa_TZWrWFlc8DFdeTWSw1bqyYFFUs" />
<title>{title === siteMetadata.title ? title : `${title} · ${siteMetadata.title}`}</title>
<meta name="author" content={siteMetadata.author.name} />
<meta property="og:locale" content="en_US" />
<meta name="description" content={description} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="canonical" href={canonical} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={siteMetadata.title} />
{image && (
	<>
		<meta property="og:image" content={image.url} />
		<meta property="og:image:height" content={String(image.height)} />
		<meta property="og:image:width" content={String(image.width)} />
		<meta name="twitter:image" content={image.url} />
	</>
)}
<meta property="og:type" content={type === "BlogPosting" ? "article" : "website"} />
{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{modifiedAt && <meta property="article:modified_time" content={modifiedAt.toISOString()} />}
<meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
<meta property="twitter:title" content={title} />
<meta name="twitter:site" content={siteMetadata.author.handle} />
<meta name="twitter:creator" content={siteMetadata.author.handle} />
<script
	type="application/ld+json"
	set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")}
/>
<link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
<link rel="alternate" type="application/rss+xml" title={siteMetadata.title} href="/rss.xml" />
<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content="#1c1917" />
