---
import type { CollectionEntry } from "astro:content";
import { featuredPosts, formatDate, postTransitionName } from "../lib/posts";
import styles from "./BlogPost.module.css";
import content from "../styles/Content.module.css";
import metadata from "../styles/Metadata.module.css";

interface Props {
	post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const featured = featuredPosts.has(post.id);
---

<article class:list={[content.page, "mx-auto"]}>
	<header class={content.heading}>
		<time
			class:list={[metadata.label, metadata.eyebrow]}
			datetime={post.data.pubDate.toISOString()}
		>
			{formatDate(post.data.pubDate)}
		</time>
		<h1
			class="heading-outline"
			data-transition={featured ? "post-title" : undefined}
			style={{
				"--post-title-transition": featured ? postTransitionName(post.id, "title") : undefined,
			}}
		>
			{post.data.title}
		</h1>
	</header>

	<div class:list={[content.prose, styles.body]}>
		<slot />
	</div>
</article>
